---
import type { Product } from '../data/products';
interface Props {
  product: Product;
  size?: 'sm' | 'md' | 'lg';
}
const { product, size = 'md' } = Astro.props;
const box = { sm: 'size-10 rounded-xl text-xs', md: 'size-14 rounded-2xl text-sm', lg: 'size-20 rounded-3xl text-lg' }[size];
---

{
  product.icon ? (
    <img src={product.icon} alt={product.name} class:list={[box, 'shrink-0 object-cover shadow-md ring-1 ring-black/5']} loading="lazy" />
  ) : (
    <span
      class:list={[box, 'grid shrink-0 place-items-center bg-linear-to-br font-extrabold tracking-tight text-white shadow-md', product.accent]}
      aria-label={product.name}
    >
      {product.mark ?? product.name.slice(0, 2)}
    </span>
  )
}
