---
import { href, locales, localeMeta, switchLocalePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { products } from '../data/products';
import Icon from './Icon.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;
const isActive = (p: string) => path === href(lang, p) || (p && path.startsWith(href(lang, p)));
const nav = [
  { label: d.nav.ecosystem, to: href(lang) + '#ecosystem', key: '#' },
  { label: d.nav.about, to: href(lang, 'about'), key: 'about' },
  { label: d.nav.contact, to: href(lang, 'contact'), key: 'contact' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/85 backdrop-blur-lg">
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href={href(lang)} class="flex items-center" aria-label="WHALEOX">
      <img src="/brand/whaleox-logo.png" alt="WHALEOX Computer" class="h-9 w-auto" width="107" height="36" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      <div class="group relative">
        <button
          class:list={[
            'flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium transition hover:text-brand-600',
            isActive('products') ? 'text-brand-600' : 'text-ink-900',
          ]}
          aria-haspopup="true"
        >
          {d.nav.products}
          <svg class="size-3.5 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5l4.5 4.5 4.5-4.5"></path></svg>
        </button>
        <div class="invisible absolute top-full left-1/2 w-[34rem] -translate-x-1/2 pt-3 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          <div class="grid grid-cols-2 gap-1 rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl shadow-ink-900/10">
            {
              products.map((p) => (
                <a href={href(lang, `products/${p.slug}`)} class="rounded-xl p-3 transition hover:bg-slate-50">
                  <div class="text-sm font-bold text-ink-900">{p.name}</div>
                  <div class="text-xs text-slate-500">{p.copy[lang].category}</div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
      {
        nav.map((n) => (
          <a
            href={n.to}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition hover:text-brand-600',
              n.key !== '#' && isActive(n.key) ? 'text-brand-600' : 'text-ink-900',
            ]}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <details class="relative" data-dropdown>
        <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-slate-200 px-3 py-2 text-xs font-semibold text-ink-900 hover:border-brand-400 [&::-webkit-details-marker]:hidden" aria-label={d.nav.language}>
          <Icon name="globe" class="size-4" />
          {localeMeta[lang].short}
        </summary>
        <ul class="absolute right-0 mt-2 w-40 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 shadow-xl">
          {
            locales.map((l) => (
              <li>
                <a
                  href={switchLocalePath(path, l)}
                  hreflang={localeMeta[l].htmlLang}
                  lang={localeMeta[l].htmlLang}
                  class:list={['flex items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-slate-50', l === lang ? 'font-semibold text-brand-600' : 'text-slate-700']}
                >
                  {localeMeta[l].label}
                  {l === lang && <Icon name="check" class="size-4" />}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href={href(lang, 'contact')} class="btn-primary hidden !py-2.5 sm:inline-flex">{d.nav.cta}</a>

      <details class="lg:hidden" data-dropdown>
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full border border-slate-200 text-ink-900 [&::-webkit-details-marker]:hidden" aria-label={d.nav.menu}>
          <Icon name="menu" />
        </summary>
        <div class="absolute inset-x-0 top-16 max-h-[calc(100vh-4rem)] overflow-y-auto border-b border-slate-200 bg-white shadow-xl">
          <div class="container-x py-4">
            <p class="eyebrow px-2 pb-2">{d.nav.products}</p>
            <div class="grid grid-cols-2 gap-1">
              {
                products.map((p) => (
                  <a href={href(lang, `products/${p.slug}`)} class="rounded-xl p-2 hover:bg-slate-50">
                    <div class="text-sm font-bold text-ink-900">{p.name}</div>
                    <div class="text-xs text-slate-500">{p.copy[lang].category}</div>
                  </a>
                ))
              }
            </div>
            <div class="mt-3 border-t border-slate-100 pt-3">
              {nav.map((n) => <a href={n.to} class="block rounded-xl px-2 py-3 font-medium text-ink-900 hover:bg-slate-50">{n.label}</a>)}
            </div>
            <a href={href(lang, 'contact')} class="btn-primary mt-3 w-full">{d.nav.cta}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown][open]').forEach((el) => {
      if (!el.contains(e.target as Node)) el.open = false;
    });
  });
</script>
