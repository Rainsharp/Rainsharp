---
import { href, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props {
  lang: Locale;
  title: string;
  body: string;
}
const { lang, title, body } = Astro.props;
const d = t(lang);
---

<section class="container-x pb-24">
  <div class="reveal relative overflow-hidden rounded-[2rem] bg-linear-to-br from-brand-500 via-brand-600 to-violet-brand px-6 py-14 text-center sm:px-12">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-2xl">
      <h2 class="text-3xl font-bold !text-white sm:text-4xl">{title}</h2>
      <p class="mt-4 text-base text-white/80">{body}</p>
      <a href={href(lang, 'contact')} class="btn mt-8 bg-white text-ink-900 shadow-lg hover:bg-slate-100">
        {d.nav.cta}
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</section>
