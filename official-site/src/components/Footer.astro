---
import { href, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { products } from '../data/products';
import { SITE } from '../data/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-slate-400">
  <div class="container-x grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <div class="inline-flex rounded-xl bg-white px-3 py-2">
        <img src="/brand/whaleox-logo.png" alt="WHALEOX Computer" class="h-8 w-auto" loading="lazy" />
      </div>
      <p class="mt-5 text-sm leading-relaxed">{d.footer.tagline}</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{d.footer.products}</p>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm md:grid-cols-1">
        {products.map((p) => <li><a href={href(lang, `products/${p.slug}`)} class="hover:text-white">{p.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{d.footer.company}</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={href(lang, 'about')} class="hover:text-white">{d.nav.about}</a></li>
        <li><a href={href(lang) + '#ecosystem'} class="hover:text-white">{d.nav.ecosystem}</a></li>
        <li><a href={href(lang, 'contact')} class="hover:text-white">{d.nav.contact}</a></li>
        {SITE.email && <li><a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalNameEn} · {SITE.legalNameZh}. {d.footer.rights}</p>
      <p class="flex items-center gap-2">
        <span class="inline-block h-2 w-6 rounded-full bg-linear-to-r from-congo-sky via-congo-gold to-red-500"></span>
        République démocratique du Congo
      </p>
    </div>
  </div>
</footer>
