---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localeMeta, switchLocalePath, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const d = t(lang);
const fullTitle = title ? `${title} · WHALEOX` : d.meta.siteTitle;
const desc = description ?? d.meta.siteDescription;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={localeMeta[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={localeMeta[l].htmlLang} href={new URL(switchLocalePath(path, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(path, 'fr'), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b1230" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    <meta property="og:image" content={new URL('/brand/whaleox-logo.png', Astro.site)} />
  </head>
  <body class="min-h-screen">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
