---
import Base from '../../layouts/Base.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import HeroVisual from '../../components/HeroVisual.astro';
import ProductMark from '../../components/ProductMark.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href, locales, type Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { products } from '../../data/products';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const d = t(lang);
const h = d.home;
const chips = [
  { icon: 'terminal', name: 'AEOMS', label: products[0].copy[lang].category, pos: 'top-[38%] left-0 sm:-left-4' },
  { icon: 'wallet', name: 'çavacash', label: products[4].copy[lang].category, pos: 'bottom-[6%] left-[4%]' },
  { icon: 'sun', name: 'IMARAPOWER', label: products[5].copy[lang].category, pos: 'top-[4%] right-0 sm:right-2' },
];
const audienceIcons = ['building', 'truck', 'user', 'bank'];
const whyIcons = ['server', 'paper', 'leaf', 'shield'];
---

<Base lang={lang}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-950 text-slate-300">
    <div class="grid-bg pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute -top-40 -left-40 size-[36rem] rounded-full bg-brand-600/25 blur-3xl"></div>
    <div class="pointer-events-none absolute right-0 bottom-0 size-[28rem] rounded-full bg-violet-brand/20 blur-3xl"></div>
    <div class="container-x relative grid items-center gap-12 pt-16 pb-20 lg:grid-cols-[1.05fr_1fr] lg:pt-24 lg:pb-28">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-300">
          <span class="inline-block h-1.5 w-5 rounded-full bg-linear-to-r from-congo-sky via-congo-gold to-red-500"></span>
          {h.eyebrow}
        </p>
        <h1 class="mt-6 text-4xl leading-[1.08] font-extrabold !text-white sm:text-5xl lg:text-6xl">
          {h.titleA}<br /><span class="text-gradient">{h.titleB}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">{h.lead}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#ecosystem" class="btn-primary">{h.ctaPrimary}<Icon name="arrow" class="size-4" /></a>
          <a href={href(lang, 'contact')} class="btn-ghost-dark">{h.ctaSecondary}</a>
        </div>
        <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-8">
          {
            h.stats.map((s) => (
              <div class="flex flex-col">
                <dt class="order-2 mt-1 text-xs leading-snug text-slate-400">{s.label}</dt>
                <dd class="text-3xl font-bold text-white">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <HeroVisual chips={chips} />
    </div>
  </section>

  <!-- Ecosystem -->
  <section id="ecosystem" class="scroll-mt-16 bg-slate-50 py-20 sm:py-28">
    <div class="container-x">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="eyebrow">{h.ecoEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.ecoTitle}</h2>
        <p class="mt-4 text-lg text-slate-600">{h.ecoLead}</p>
      </div>
      <div class="reveal mt-12">
        <Ecosystem lang={lang} />
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="py-20 sm:py-28">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">{h.productsEyebrow}</p>
          <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{h.productsTitle}</h2>
        </div>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((p) => (
            <a
              href={href(lang, `products/${p.slug}`)}
              class="reveal group relative flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-600/10"
            >
              <span class:list={['absolute inset-x-0 top-0 h-1 bg-linear-to-r opacity-0 transition group-hover:opacity-100', p.accent]} />
              <div class="flex items-center gap-4">
                <ProductMark product={p} />
                <div>
                  <h3 class="text-lg font-bold">{p.name}</h3>
                  <p class="text-xs font-medium text-brand-600">{p.copy[lang].category}</p>
                </div>
              </div>
              <p class="mt-5 flex-1 text-sm leading-relaxed text-slate-600">{p.copy[lang].summary}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-900 group-hover:text-brand-600">
                {d.common.learnMore}
                <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Journey -->
  <section class="bg-ink-950 py-20 text-slate-300 sm:py-28">
    <div class="container-x">
      <div class="reveal max-w-2xl">
        <p class="eyebrow !text-brand-300">{h.journeyEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold !text-white sm:text-4xl">{h.journeyTitle}</h2>
      </div>
      <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          h.journey.map((s, i) => (
            <li class="reveal relative rounded-3xl border border-white/10 bg-white/[0.03] p-6">
              <span class="text-gradient text-4xl font-extrabold">0{i + 1}</span>
              <h3 class="mt-4 text-lg font-semibold !text-white">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Audiences + why -->
  <section class="py-20 sm:py-28">
    <div class="container-x grid gap-16 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">{h.audiencesEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold">{h.audiencesTitle}</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            h.audiences.map((a, i) => (
              <div class="rounded-2xl border border-slate-200 p-5">
                <span class="grid size-10 place-items-center rounded-xl bg-brand-500/10 text-brand-600">
                  <Icon name={audienceIcons[i]} />
                </span>
                <h3 class="mt-4 font-semibold">{a.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{a.body}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="reveal">
        <p class="eyebrow">{h.whyEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold">{h.whyTitle}</h2>
        <ul class="mt-8 space-y-4">
          {
            h.why.map((w, i) => (
              <li class="flex gap-4 rounded-2xl bg-slate-50 p-5">
                <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white text-brand-600 shadow-sm">
                  <Icon name={whyIcons[i]} />
                </span>
                <div>
                  <h3 class="font-semibold">{w.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600">{w.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={h.ctaTitle} body={h.ctaBody} />
</Base>
